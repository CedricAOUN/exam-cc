# Generate independent random values with: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
SERVICE_TOKEN=replace-with-a-different-random-secret-at-least-32-characters

# Host-side Node development only; Compose overrides these with internal addresses.
MONGO_URI=mongodb://127.0.0.1:27018/exam1Db?replicaSet=rs0&directConnection=true
GATEWAY_URL=http://localhost:8000
NOTIFI_SERVICE_URL=http://localhost:4002
STOCK_SERVICE_URL=http://localhost:4003

# HTTP is supported only for local development. Set true behind HTTPS.
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional administrator email for stock notifications.
NOTIFICATION_EMAIL=
# Without both Gmail credentials, email delivery is disabled (HTTP 202).
EMAIL_USER=
EMAIL_APPLICATION_PASSWORD=
